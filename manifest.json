{
  "manifest_version": 3,
  "name": "Toman Price for Dubizzle & OpenSooq",
  "version": "1.5.0",
  "description": "Shows the Iranian Toman equivalent of prices on Dubizzle, OpenSooq and 4Sale, with a live per-currency rate (AED, KWD) from Navasan.net or a manual rate.",
  "minimum_chrome_version": "100",
  "permissions": ["storage"],
  "host_permissions": [
    "*://dubizzle.com/*",
    "*://*.dubizzle.com/*",
    "*://opensooq.com/*",
    "*://*.opensooq.com/*",
    "*://q84sale.com/*",
    "*://*.q84sale.com/*",
    "*://navasan.net/*",
    "*://*.navasan.net/*"
  ],
  "action": {
    "default_title": "Dubizzle Toman Price",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://dubizzle.com/*",
        "*://*.dubizzle.com/*",
        "*://opensooq.com/*",
        "*://*.opensooq.com/*",
        "*://q84sale.com/*",
        "*://*.q84sale.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
